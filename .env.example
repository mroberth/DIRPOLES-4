# ===== APP =====
APP_ENV=local              # local | staging | production
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:19006,http://localhost:5173

# ===== MICROSERVICIO DE IA (DIRPOLES-IA) =====
DIRPOLES_IA_URL=http://127.0.0.1:8000
DIRPOLES_IA_API_KEY=tu_clave_api_aqui

