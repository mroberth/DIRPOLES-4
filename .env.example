# ===== BASE DE DATOS DE NEGOCIO =====
DB_HOST=localhost
DB_NAME=dirpoles_business
DB_USER=root
DB_PASS=

# ===== BASE DE DATOS DE SEGURIDAD =====
DB_SECURITY_NAME=dirpoles_security
DB_SECURITY_USER=root
DB_SECURITY_PASS=

# ===== JWT =====
JWT_EXPIRATION=3600        # segundos (1 hora)
